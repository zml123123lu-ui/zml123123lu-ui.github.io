---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Illo from '../components/Illo.astro';
import EnvelopeIntro from '../components/EnvelopeIntro.astro';
import text from '../data/site-text.json';
import { SITE, NAV, fmtDate, thousands } from '../consts';
import { getPosts, totalChars } from '../utils/posts';

const posts = await getPosts();
const entries = {
  about: { label: '关于', title: text.home.about, note: text.home.aboutNote, field: 'about', href: '/about/', tone: 'purple', icon: 'moon' },
  shelf: { label: '书影音', title: text.home.shelf, note: text.home.shelfNote, field: 'shelf', href: '/shelf/', tone: 'blue', icon: 'record' },
  works: { label: '作品', title: text.home.works, note: text.home.worksNote, field: 'works', href: '/works/', tone: 'yellow', icon: 'book' },
  accounts: { label: '账号', title: text.home.accounts, note: text.home.accountsNote, field: 'accounts', href: '/accounts/', tone: 'green', icon: 'spark' },
} as const;
type Cell = ({ kind: 'glyph'; character: string; caption: string } | { kind: 'entry'; key: keyof typeof entries } | { kind: 'post'; index: number } | { kind: 'illustration'; name: 'book' | 'record' | 'moon' | 'plant'; label: string; tone?: string }) & { extra?: boolean; mobileHidden?: boolean };
// 满宽三排：宽屏四列，矮屏五列；手机继续三列九格，避免内容过密。
const cells: Cell[] = [
  { kind: 'glyph', character: SITE.mark, caption: SITE.latin },
  { kind: 'entry', key: 'about' },
  { kind: 'post', index: 0 },
  { kind: 'entry', key: 'shelf' },
  { kind: 'illustration', name: 'record', label: '在听', extra: true, mobileHidden: true },
  { kind: 'entry', key: 'works' },
  { kind: 'post', index: 1 },
  { kind: 'entry', key: 'accounts' },
  { kind: 'post', index: 2 },
  { kind: 'illustration', name: 'moon', label: '日常', tone: 'pale-purple', extra: true, mobileHidden: true },
  { kind: 'post', index: 3, mobileHidden: true },
  { kind: 'illustration', name: 'book', label: '在读', tone: 'pale-green', mobileHidden: true },
  { kind: 'post', index: 4, mobileHidden: true },
  { kind: 'illustration', name: 'plant', label: '生长', tone: 'pale-yellow', extra: true, mobileHidden: true },
  { kind: 'glyph', character: '己', caption: 'KNOW THYSELF' },
];
---
<BaseLayout bare={true}>
<EnvelopeIntro />
<div class="home">
  <div class="topnote">
    <span><span data-edit-kind="site" data-edit-id="identity" data-edit-field="name">{SITE.name}</span> · <span data-edit-kind="site" data-edit-id="identity" data-edit-field="tagline">{SITE.tagline}</span></span>
    <span>共 {posts.length} 篇 · {thousands(totalChars(posts))} 字</span>
  </div>
  <nav class="grid grid-nav" aria-label="主导航">
    <a class="cell navcell brandcell" href="/"><span class="bc"><span class="dot"></span><b data-edit-kind="site" data-edit-id="identity" data-edit-field="name">{SITE.name}</b><span class="mono dim">{SITE.latin}</span></span></a>
    {NAV.slice(0,3).map(item=><a class="cell navcell" href={item.href}><span class="lk">{item.label}</span><span class="sub">{item.sub}</span></a>)}
    <a class="cell navcell" href="/rss.xml"><span class="lk">订阅 →</span><span class="sub">RSS / 邮件</span></a>
  </nav>
  <div class="grid grid-body">
    {cells.map(cell=>{
      if(cell.kind==='glyph')return <div class="cell glyph"><span class="idx">{cell.caption}</span><b>{cell.character}</b></div>;
      if(cell.kind==='entry'){
        const item=entries[cell.key];
        return <a class:list={['cell','solid','content-entry',item.tone,item.field]} href={item.href}>
          <span class="entry-head"><span class="idx">{item.label}</span><Illo name={item.icon} weight={1.8}/></span>
          <span class="biglink"><span data-edit-kind="site" data-edit-id="home" data-edit-field={item.field}>{item.title}</span><span class="arw" aria-hidden="true">→</span></span>
          <span class="idx note" data-edit-kind="site" data-edit-id="home" data-edit-field={item.field+'Note'}>{item.note}</span>
        </a>;
      }
      if(cell.kind==='illustration')return <div class:list={['cell','illustration',cell.name,cell.extra && 'extra',cell.mobileHidden && 'mobile-hidden',cell.tone && 'solid',cell.tone]}><span class="idx">{cell.label}</span><Illo name={cell.name} weight={1.8}/></div>;
      const post=posts[cell.index];
      if(!post)return <div class:list={['cell','empty',cell.extra && 'extra',cell.mobileHidden && 'mobile-hidden']} data-post-index={cell.index}><span class="idx">留白</span><span class="empty-text">下一篇，慢慢写。</span></div>;
      return <a class:list={['cell','art',cell.extra && 'extra',cell.mobileHidden && 'mobile-hidden']} data-post-index={cell.index} href={`/posts/${post.id}/`}>
        <span class="idx">{String(cell.index+1).padStart(2,'0')} / {post.data.category}</span>
        <span class="body"><span class="tit" data-edit-kind="posts" data-edit-id={post.id} data-edit-field="title">{post.data.title}</span>{post.data.category === '开发' && post.data.subtitle && <span class="post-subtitle" data-edit-kind="posts" data-edit-id={post.id} data-edit-field="subtitle">{post.data.subtitle}</span>}</span>
        <span class="idx date">{fmtDate(post.data.pubDate)}</span>
      </a>;
    })}
  </div>
  <SiteFooter />
</div>
</BaseLayout>
<style>
.body .post-subtitle{font-size:clamp(10px,4cqw,20px);line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
a.cell:is(:hover,:focus-visible) .post-subtitle{color:var(--home-hover-dim)}
@media(max-width:720px){.body .post-subtitle{margin-top:3px}}
.home{width:100%;margin:0;display:flex;flex-direction:column;--home-hover:var(--ink);--home-hover-dim:var(--bg)}
.topnote{width:100%;margin:0;display:flex;justify-content:space-between;gap:20px;padding:13px var(--gutter);font:10px/1.5 var(--mono);letter-spacing:.08em;color:var(--ink-55);border-bottom:1px solid var(--rule)}
.grid{display:grid;width:100%;margin:0}.grid-nav{grid-template-columns:repeat(5,minmax(0,1fr));flex-shrink:0}.grid-body{grid-template-columns:repeat(4,minmax(0,1fr));grid-auto-rows:auto;flex:none;min-height:0}
.grid-body>.cell{aspect-ratio:1;container-type:inline-size}.cell.extra{display:none}.cell.illustration{align-items:center;justify-content:center}.illustration>.idx{position:absolute;left:12px;top:12px}.illustration :global(svg){width:56%;max-width:240px;height:auto}
.cell{min-width:0;min-height:0;position:relative;display:flex;flex-direction:column;justify-content:space-between;border-right:1px solid var(--rule);border-bottom:1px solid var(--rule);padding:18px 20px;background:var(--bg);transition:background .25s var(--ease),color .25s var(--ease)}
.grid-body>.cell:last-child,.grid-body>.shelf,.grid-body>[data-post-index="2"],.grid-nav>.cell:last-child{border-right:0}.navcell{height:46px;padding:0 10px;justify-content:center}.bc{display:flex;align-items:center;gap:6px}.bc b{font:700 18px var(--disp)}.dot{width:8px;height:8px;background:var(--ink);border-radius:50%;flex:none}.bc .mono{font-size:10px}.lk{font:500 13px var(--disp)}.sub{font:10px var(--mono);color:var(--ink-55);margin-top:3px}
.idx{font:clamp(8px,3cqw,14px)/1.5 var(--mono);letter-spacing:.03em;color:var(--ink-72)}.glyph{align-items:center;justify-content:center;padding:0;background:var(--ink);color:var(--bg)}.glyph>.idx{position:absolute;top:12px;left:12px;color:var(--bg);opacity:.75}.glyph b{font:700 clamp(52px,48cqw,260px)/.85 var(--disp);letter-spacing:-.03em}
.entry-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}.entry-head :global(svg){width:clamp(18px,8cqw,42px);height:auto;flex-shrink:0}.biglink{font:700 clamp(15px,8.4cqw,42px)/1.2 var(--disp);display:flex;align-items:center;gap:6px}.arw{font-size:18px;transition:transform .25s var(--ease)}.note{margin-top:8px}
.body{display:flex;flex-direction:column;justify-content:center;gap:8px;flex:1;padding:6px 0}.tit{font:500 clamp(13px,6cqw,30px)/1.35 var(--disp);text-wrap:balance;display:-webkit-box;-webkit-line-clamp:3;line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.date{margin-top:4px}.empty-text{font:20px var(--disp);margin:auto 0;color:var(--ink-55)}
a.cell:is(:hover,:focus-visible){background:var(--home-hover);color:var(--bg)}a.cell:is(:hover,:focus-visible) :is(.idx,.sub,.dim){color:var(--home-hover-dim)}a.content-entry:is(:hover,:focus-visible) .arw{transform:translateX(6px)}
.home :global(footer.foot){margin-top:0;flex-shrink:0}.home :global(.fin){padding-top:14px;padding-bottom:14px;justify-content:center;gap:16px}.home :global(.fin>.col){display:none}.home :global(.links){justify-content:center;font-size:10px;gap:8px 12px}
@media(min-width:721px) and (max-height:879px){
  .grid-body{grid-template-columns:repeat(5,minmax(0,1fr))}
  .grid-body>.extra{display:flex}
  .grid-body>.shelf{border-right:1px solid var(--rule)}
  .grid-body>.record,.grid-body>.moon{border-right:0}
  .grid-body>[data-post-index="2"]{border-right:1px solid var(--rule)}
}
@media(min-width:721px) and (max-width:1100px){.cell{padding:12px}.bc .mono{display:none}}
@media(max-width:720px){
  .topnote{padding:12px 8px;gap:8px;flex-wrap:wrap;font-size:8px}
  .grid-nav{grid-template-columns:repeat(4,minmax(0,1fr))}
  .brandcell{grid-column:1/-1;border-right:0}
  .navcell{height:40px;padding:0 9px}.bc .mono{display:none}
  .lk{font-size:12px}.sub{font-size:8px}
  .grid-body{grid-template-columns:repeat(3,minmax(0,1fr));grid-auto-rows:auto}
  .grid-body>.mobile-hidden{display:none}
  .grid-body>.cell{padding:10px;border-right:1px solid var(--rule)}
  .grid-body>.glyph:first-child{order:0}
  .grid-body>.about{order:1}
  .grid-body>[data-post-index="0"]{order:2;border-right:0}
  .grid-body>.shelf{order:3}
  .grid-body>[data-post-index="1"]{order:4}
  .grid-body>.works{order:5;border-right:0}
  .grid-body>[data-post-index="2"]{order:6}
  .grid-body>.accounts{order:7}
  .grid-body>.glyph:last-child{order:8;border-right:0}
  .glyph>.idx{top:10px;left:10px}
  .body{padding:4px 0;gap:0}.biglink{line-height:1.3}.arw{display:none}
  .note{line-height:1.5;margin-top:4px}
  .home :global(.fin){padding:16px 8px}
  .home :global(.links){gap:8px 10px;font-size:9px}
}
@media(max-width:360px){
  .grid-body>.cell{padding:8px}.tit{-webkit-line-clamp:2;line-clamp:2}
}
@media(min-width:721px){
  .tit{font-size:clamp(18px,7.2cqw,32px)}
  .biglink{font-size:clamp(24px,8.4cqw,42px)}
  .idx{font-size:clamp(11px,3cqw,15px)}
  .body .post-subtitle{font-size:clamp(13px,4.3cqw,22px)}
}
</style>
