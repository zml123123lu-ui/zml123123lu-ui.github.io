---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, fmtDate } from '../consts';
import { getPosts } from '../utils/posts';

const posts = await getPosts();
const essays = posts.filter(post => post.data.category === '随笔');
const featured = [essays[0], posts.find(post => post.data.category === '开发'), essays[1]];
const entries = [
  { title: '关于', href: '/about/' },
  { title: '书影音', href: '/shelf/' },
  { title: '作品', href: '/works/' },
  { title: '账号', href: '/accounts/' },
];
---
<BaseLayout bare={true}>
  <header>
    <a class="brand" href="/" aria-label="见己首页"><span data-edit-kind="site" data-edit-id="identity" data-edit-field="name">{SITE.name}</span></a>
    <a class="all" href="/posts/">全部写作 ↗</a>
  </header>
  <div class="scene" aria-label="文章与栏目，移动鼠标或拖动浏览">
    <div class="orbit"><div class="room"><div class="back">
      {featured.map((post, i) => post && (
        <a class:list={['paper', 'article', `a${i}`]} aria-label={post.data.title} style={`--chars:${[...post.data.title].length};--type-size:${Math.max(18, 37 - [...post.data.title].length)}px`} href={`/posts/${post.id}/`}>
          <span class="float">
            <span class="meta">{post.data.category} / {fmtDate(post.data.pubDate)}</span>
            <h2 data-edit-kind="posts" data-edit-id={post.id} data-edit-field="title">{post.data.title}</h2>
            <span class="read">读这一篇 <span aria-hidden="true">↗</span></span>
          </span>
        </a>
      ))}
      {entries.map((entry, i) => (
        <a class:list={['paper', 'entry', `e${i}`]} aria-label={entry.title} href={entry.href}>
          <span class="float"><span class="entry-title">{entry.title}</span><span class="arrow" aria-hidden="true">↗</span></span>
        </a>
      ))}
    </div></div></div>
  </div>
  <h1 class="word"><b>{[...SITE.name].map(character => <span>{character}</span>)}</b><span>{SITE.latin}</span></h1>
  <footer class="bottom">
    <span class="desktop-hint">移动鼠标，慢慢浏览。</span><span class="mobile-hint">拖动浏览</span>
    <div class="controls"><button id="motion" type="button" aria-pressed="false">播放动态 ↗</button><a href="/search/">搜索 ↗</a></div>
  </footer>
</BaseLayout>
<style>
*{box-sizing:border-box}
:global(html),:global(body){margin:0;width:100%;height:100%;background:var(--bg);color:var(--ink)}
:global(body){font-family:'Songti SC',STSong,serif;overflow:hidden}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;cursor:pointer}
a,button{-webkit-tap-highlight-color:transparent}
a:focus-visible,button:focus-visible{outline:1px solid var(--ink);outline-offset:6px}
header{position:fixed;top:0;left:0;right:0;z-index:5;height:90px;padding:0 36px;display:flex;align-items:center;justify-content:space-between;background:var(--bg)}
.brand{font-size:24px;letter-spacing:4px;font-weight:600}
.all{font:11px -apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif}
.all:hover{text-decoration:underline;text-underline-offset:6px}
.scene{position:fixed;inset:50px 0 64px;overflow:hidden;perspective:1300px;perspective-origin:50% 50%;touch-action:none;cursor:grab}
.scene:active{cursor:grabbing}
.orbit,.room,.back{position:absolute;inset:0;transform-style:preserve-3d;pointer-events:none}
.orbit{transition:transform .6s cubic-bezier(.2,.7,.2,1)}
.room{width:100%;height:100%}
.back{transform:translateZ(-100px)}
.paper{position:absolute;pointer-events:auto;padding:10px;display:block;width:max-content;min-height:44px;transform-style:preserve-3d;cursor:pointer;background:transparent}
.meta{position:absolute;right:calc(100% + 7px);top:12px;writing-mode:vertical-rl;font:9px/1.4 -apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif;color:var(--ink-55);letter-spacing:.08em;white-space:nowrap}
h2{font-family:inherit;font-weight:400;font-size:clamp(15px,calc(34vh / var(--chars) / 1.12),var(--type-size));line-height:1.25;letter-spacing:.12em;margin:0;writing-mode:vertical-rl;text-orientation:mixed;white-space:nowrap}
.float{display:block;position:relative;transform-style:preserve-3d}
.paper{transform:translateZ(var(--depth,0px));transition:transform .65s ease-out}
.read{position:absolute;left:50%;top:100%;writing-mode:vertical-rl;font:9px/1.5 -apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif;color:var(--ink-55);margin-top:12px;opacity:0;transition:opacity .2s}
.article:is(:hover,:focus-visible) .read{opacity:1}
.article:is(:hover,:focus-visible) h2{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:8px}
.a0{--depth:36px;left:16%;top:5%;}
.a1{--depth:-21px;left:73%;top:12%;}
.a2{--depth:48px;left:38%;top:2%;}
.entry-title{font-size:clamp(46px,6.4vh,72px);font-weight:500;line-height:1.18;letter-spacing:.08em;writing-mode:vertical-rl;white-space:nowrap;display:block}
.arrow{position:absolute;left:50%;bottom:-20px;font:17px -apple-system,sans-serif;opacity:0;transform:translateX(-6px);transition:opacity .2s,transform .2s}
.entry:is(:hover,:focus-visible) .arrow{opacity:1;transform:none}
.e0{--depth:27px;left:9%;top:60%;}
.e1{--depth:-30px;left:30%;top:73%;}
.e1 .entry-title{font-size:clamp(36px,5vh,55px)}
.e2{--depth:42px;left:67%;top:68%;}
.e3{--depth:-18px;left:87%;top:51%;}
.word{margin:0;font-family:inherit;font-size:clamp(64px,9vh,104px);width:1.2em;position:fixed;left:50%;top:50%;z-index:4;transform:translate(-50%,-50%);pointer-events:none;text-align:center}
.word b{display:flex;flex-direction:column;align-items:center;width:100%;font-size:inherit;font-weight:500;letter-spacing:0;line-height:1.08;white-space:nowrap}
.word b span{display:block;height:1.08em}
.word>span{position:absolute;top:calc(100% + 18px);left:0;width:100%;font:8px/2 monospace;letter-spacing:.3em;text-indent:.3em;text-align:center;color:var(--ink-55);white-space:nowrap}

.bottom{position:fixed;bottom:0;left:0;right:0;height:64px;padding:0 36px;display:flex;align-items:center;justify-content:space-between;z-index:5;background:var(--bg);font:10px/1.6 -apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif;color:var(--ink-55)}
.controls{display:flex;gap:24px;align-items:center}
.controls button{border:0;border-bottom:1px solid var(--rule-strong);background:none;padding:5px 0;font:inherit;color:var(--ink)}
.controls a{color:var(--ink-72)}
.mobile-hint{display:none}

@media(max-width:900px){header{height:66px;padding:0 22px}
.brand{font-size:21px}
.all{font-size:10px}
.scene{inset:65px 0 82px;perspective:1000px}
.back{transform:none}
.paper{padding:6px;transform:translateZ(calc(var(--depth,0px)*.35))}
.meta{font-size:8px;right:calc(100% + 2px);top:9px;letter-spacing:0}
h2{font-size:clamp(12.5px,calc(27vh / var(--chars) / 1.12),18px);letter-spacing:.1em}
.read{display:none}
.a0{left:10%;top:5%}
.a1{left:43%;top:2%}
.a1 h2{font-size:16px}
.a2{left:76%;top:9%}
.entry-title{font-size:36px;letter-spacing:.04em}
.e0{left:13%;top:58%}
.e1{left:36%;top:73%}
.e1 .entry-title{font-size:29px}
.e2{left:72%;top:74%}
.e3{left:79%;top:46%}
.e3 .entry-title{font-size:33px}
.word{left:50%;top:50%;font-size:53px;transform:translate(-50%,-50%)}
.word>span{font-size:7px;top:calc(100% + 12px)}
.bottom{height:75px;padding:0 22px;gap:10px;font-size:9px}
.desktop-hint{display:none}
.mobile-hint{display:inline}
.controls{gap:16px}
}

@media(prefers-reduced-motion:reduce){.orbit,.paper,.read,.arrow{transition:none}
}

:global(.has-page-editor){padding-bottom:0}
:global(body.has-page-editor #page-editor){bottom:80px}
 @media(max-width:900px){:global(body.has-page-editor #page-editor){bottom:74px;padding:6px 10px}
}


</style>
<script>
const scene = document.querySelector<HTMLElement>('.scene')!;
const button = document.querySelector<HTMLButtonElement>('#motion')!;
const papers = [...document.querySelectorAll<HTMLElement>('.paper')];
let running = false;
let down: { x: number; y: number } | null = null;
let dragged = false;
let frame = 0;
const loops: Animation[] = [];
function move(x: number, y: number) {
  if (document.body.classList.contains('editing-page')) return;
  cancelAnimationFrame(frame);
  frame = requestAnimationFrame(() => papers.forEach((el, i) => {
    const depth = [12, -7, 16, 9, -10, 14, -6][i] * (innerWidth <= 900 ? .35 : 1);
    el.style.transform = `translate3d(${x * depth}px,${y * depth * .55}px,${depth * 3}px)`;
  }));
}
scene.addEventListener('pointerdown', e => { down = { x: e.clientX, y: e.clientY }; dragged = false; });
scene.addEventListener('pointermove', e => {
  if (e.pointerType === 'touch' && !down) return;
  if (down && Math.hypot(e.clientX - down.x, e.clientY - down.y) > 7) dragged = true;
  move((e.clientX / innerWidth - .5) * 2, (e.clientY / innerHeight - .5) * 2);
});
scene.addEventListener('pointerleave', () => move(0, 0));
window.addEventListener('pointerup', () => { down = null; });
scene.addEventListener('click', e => { if (dragged) { e.preventDefault(); dragged = false; } }, true);
function toggle() {
  if (running) {
    loops.splice(0).forEach(a => a.cancel());
    running = false;
  } else {
    papers.forEach((el, i) => {
      const dx = i % 2 ? 6 : -6, dy = i % 3 ? 10 : -10;
      loops.push(el.querySelector('.float')!.animate([
        { transform: 'translate3d(0,0,0)' },
        { transform: `translate3d(${dx}px,${dy}px,24px)` },
        { transform: 'translate3d(0,0,0)' },
      ], { duration: 7000 + i * 650, delay: -(i * 1130), iterations: Infinity, easing: 'ease-in-out' }));
    });
    running = true;
  }
  button.textContent = running ? '暂停动态 ‖' : '播放动态 ↗';
  button.setAttribute('aria-pressed', String(running));
}
button.addEventListener('click', toggle);
document.getElementById('edit-toggle')?.addEventListener('click', () => { if (running) toggle(); });
document.addEventListener('visibilitychange', () => loops.forEach(a => document.hidden ? a.pause() : a.play()));
window.addEventListener('pagehide', () => { loops.forEach(a => a.cancel()); cancelAnimationFrame(frame); });
if (!matchMedia('(prefers-reduced-motion:reduce)').matches) toggle();

</script>
