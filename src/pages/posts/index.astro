---
import text from '../../data/site-text.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WritingCards from '../../components/WritingCards.astro';
import { SITE, fmtDate } from '../../consts';
import { getPosts, categoryCounts } from '../../utils/posts';

const posts = await getPosts();
const categories = categoryCounts(posts).filter(category => category.count > 0);
const latest = posts[0]?.data.pubDate;
---
<BaseLayout title="写作" section="写作" description={`${SITE.name} 的全部文章，共 ${posts.length} 篇。`}>
  <div class="wrap writing-page">
    <header class="writing-hero">
      <div class="edition"><span>JIANJI / WRITING</span><span>{latest?.getFullYear() ?? SITE.since}</span></div>
      <h1 data-edit-kind="site" data-edit-id="posts" data-edit-field="title">{text.posts.title}</h1>
      <div class="hero-bottom">
        <p data-edit-kind="site" data-edit-id="posts" data-edit-field="intro">{text.posts.intro}</p>
        <a class="article-count" href="#articles" aria-label={`浏览全部 ${posts.length} 篇文章`}><span>{String(posts.length).padStart(2, '0')}</span><small>篇写作 ↓</small></a>
      </div>
    </header>
    <nav class="writing-nav" aria-label="写作分类">
      <div class="categories"><a href="#articles" aria-current="page">全部 <sup>{posts.length}</sup></a>{categories.map(category => <a href={`/tags/${encodeURIComponent(category.name)}/`}>{category.name} <sup>{category.count}</sup></a>)}</div>
      <div class="tools"><a href="/archive/">归档 ↗</a><a href="/search/">搜索 ↗</a></div>
    </nav>
    <section id="articles" aria-labelledby="directory-title">
      <div class="directory-heading"><h2 id="directory-title">逐篇翻阅</h2><span>按时间倒序 / {latest ? fmtDate(latest) : '等待第一篇'}</span></div>
      {posts.length ? <WritingCards posts={posts} /> : <p class="empty-writing">下一篇，慢慢写。</p>}
    </section>
    <div class="writing-end"><span>写到这里，仍在继续。</span><a href="#main">回到页首 ↑</a></div>
  </div>
</BaseLayout>
<style>
:global(:root:has(.writing-page)){--bg:#fff;--ink:#0b0b0b;--ink-72:rgb(11 11 11 / .75);--ink-55:rgb(11 11 11 / .65);--ink-38:rgb(11 11 11 / .6);--ink-22:rgb(11 11 11 / .22);--rule:#dedede;--rule-strong:#aaa;--paper:#fafafa;--yellow:#e1e1e1;--teal:var(--ink-72);--clay:var(--ink-72)}
.writing-page{font-family:var(--ui)}
:global(body:has(.writing-page)){overflow-x:clip}
.writing-hero{padding:42px 0 30px}
.edition{display:flex;justify-content:space-between;gap:20px;font:11px/1.5 var(--mono);letter-spacing:.1em}
h1{font:500 clamp(34px,4vw,54px)/1.25 var(--disp);letter-spacing:-.02em;margin:16px 0;overflow-wrap:anywhere;text-wrap:balance}
.hero-bottom{display:flex;justify-content:space-between;align-items:flex-end;gap:32px}
.hero-bottom p{font:15px/1.9 var(--song);max-width:30em;color:var(--ink-55)}
.article-count{display:flex;align-items:baseline;gap:8px;flex-shrink:0}
.article-count>span{font:500 24px/1.2 var(--disp);letter-spacing:0}
.article-count small{font:12px var(--ui);white-space:nowrap}
.writing-nav{position:sticky;top:56px;z-index:10;background:var(--bg);display:flex;align-items:center;justify-content:space-between;gap:24px;border-block:1px solid var(--rule);padding:22px 0}
.categories,.tools{display:flex;align-items:center;gap:28px}
.categories a{font-weight:600;font-size:18px;white-space:nowrap}
.categories sup{font:10px var(--mono);margin-left:3px;color:var(--ink-55)}
.categories a[aria-current]{text-decoration:underline;text-underline-offset:7px}
.tools a{font-size:12px;white-space:nowrap}
.writing-nav a:hover{text-decoration:underline;text-underline-offset:7px}
#articles{scroll-margin-top:145px}
.directory-heading{display:flex;justify-content:space-between;gap:24px;padding:30px 0 24px;font:11px/1.6 var(--mono);color:var(--ink-55)}
.directory-heading h2{font:inherit}
.writing-end{display:flex;justify-content:space-between;gap:24px;padding:56px 0 76px;font:12px/1.6 var(--ui);color:var(--ink-55)}
.empty-writing{font:28px/1.5 var(--song);padding:70px 0;border-block:1px solid var(--rule)}
@media(max-width:760px){
 .writing-hero{padding:30px 0}
 .edition{font-size:9px}
 h1{font-size:34px;margin:16px 0;max-width:none}
 .hero-bottom{align-items:baseline;gap:20px}
 .hero-bottom p{font-size:15px;max-width:24em}
 .article-count>span{font-size:24px}
 .article-count small{font-size:10px}
 .writing-nav{gap:18px;padding:18px 0;align-items:flex-start;flex-wrap:wrap}
 .categories{gap:22px}.categories a{font-size:15px}.tools{gap:18px}.tools a{font-size:11px}
 .directory-heading{font-size:9px;gap:14px;padding:25px 0 20px}
 .writing-end{font-size:10px;padding:36px 0 48px}
}
</style>
