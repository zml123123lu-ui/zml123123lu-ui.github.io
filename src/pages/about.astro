---
/**
 * 关于页。
 * 左栏是「事实栏」（头像、现在在做什么、联系方式），右栏是正文。
 */
import { render, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, fmtDate, thousands } from '../consts';
import { getPosts, totalChars, byYear } from '../utils/posts';

const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('缺少 src/content/pages/about.md');
const { Content } = await render(entry);

const posts = await getPosts();
const years = byYear(posts);
const chars = totalChars(posts);
const latest = posts[0]?.data.pubDate;
---

<BaseLayout title="关于" section="关于" description={SITE.author.bio}>
  <div class="wrap">
    <div class="cols">
      <!-- 事实栏 -->
      <aside class="fact">
        <div class="avatar">
          <img src="/avatar.jpg" alt={`${SITE.author.name} 的头像`} width="640" height="640" />
        </div>

        <h2 class="who" data-edit-kind="site" data-edit-id="identity" data-edit-field="author">{SITE.author.name}</h2>
        <p class="bio" data-edit-kind="site" data-edit-id="identity" data-edit-field="bio">{SITE.author.bio}</p>

        <ul class="facts">
          <li>
            <span class="k">在写</span>
            <span class="v">{posts.length} 篇</span>
          </li>
          <li>
            <span class="k">字数</span>
            <span class="v">{thousands(chars)} 字</span>
          </li>
          <li>
            <span class="k">跨度</span>
            <span class="v">
              {years.length > 1 ? `${years[years.length - 1].year} — ${years[0].year}` : `${SITE.since}`}
            </span>
          </li>
          <li>
            <span class="k">最近更新</span>
            <span class="v">{latest ? fmtDate(latest) : '—'}</span>
          </li>
        </ul>

        <div class="links">
          {SITE.author.links.map((l) => (
            <a
              href={l.href}
              target={l.href.startsWith('http') ? '_blank' : undefined}
              rel={l.href.startsWith('http') ? 'me noopener' : undefined}
            >
              <span>{l.label}</span>
              <span class="arw" aria-hidden="true">→</span>
            </a>
          ))}
          {/* 两个邮箱都列出来：一个QQ一个Gmail，哪个顺手用哪个。
              邮箱直接当标签写，方便复制 —— 只写「邮箱」两个字，别人还得先点一下才知道地址。 */}
          {[SITE.author.email, SITE.author.emailAlt]
            .filter((m) => m !== '')
            .map((m) => (
              <a href={`mailto:${m}`}>
                <span>{m}</span>
                <span class="arw" aria-hidden="true">→</span>
              </a>
            ))}
        </div>
      </aside>

      <!-- 正文 -->
      <article class="prose" data-pagefind-body data-edit-kind="site" data-edit-id="about" data-edit-field="body">
        <Content />
        <p class="tail">
          <a class="btn" href="/posts/"><span aria-hidden="true">←</span> 去看文章</a>
        </p>
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  .cols {
    display: grid;
    grid-template-columns: 258px minmax(0, 1fr);
    gap: 56px;
    padding: 46px 0 20px;
  }

  /* ── 事实栏 ───────────────────────────────────────────────────── */
  .fact {
    border-right: 1px solid var(--rule);
    padding-right: 40px;
  }

  .avatar {
    width: 104px;
    height: 104px;
    border: 1px solid var(--rule);
    overflow: hidden;
    margin-bottom: 20px;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .who {
    font-family: var(--disp);
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 10px;
  }

  .bio {
    font-family: var(--song);
    font-size: 13.5px;
    line-height: 1.85;
    color: var(--ink-55);
    margin-bottom: 24px;
  }

  .facts {
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .facts li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px dashed var(--rule);
  }
  .facts .k {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--ink-38);
    letter-spacing: 0.06em;
  }
  .facts .v {
    font-family: var(--disp);
    font-size: 14px;
    font-weight: 600;
  }

  .links { display: flex; flex-direction: column; }
  .links a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 9px 10px;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--ink-72);
    transition: background 0.22s var(--ease), color 0.22s var(--ease);
  }
  .links a:hover { background: var(--yellow); color: var(--on-light); }
  .links .arw { transition: transform 0.3s var(--ease); }
  .links a:hover .arw { transform: translateX(4px); }

  /* ── 正文 ─────────────────────────────────────────────────────── */
  .prose { max-width: var(--measure); }
  .prose :global(h2:first-child) { margin-top: 0; }

  .tail { margin-top: 3em; }

  @media (max-width: 900px) {
    .cols {
      grid-template-columns: 1fr;
      gap: 34px;
      padding-top: 34px;
    }
    .fact {
      border-right: 0;
      border-bottom: 1px solid var(--rule);
      padding: 0 0 30px;
    }
  }
</style>
