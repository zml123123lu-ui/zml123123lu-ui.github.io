---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, fmtDate, categoryClass } from '../consts';
import { getPosts } from '../utils/posts';
import { getCollection } from 'astro:content';
const [posts,moments]=await Promise.all([getPosts(),getCollection('moments')]);
const entries=[
 ...posts.map(post=>({date:post.data.pubDate,title:post.data.title,subtitle:post.data.category==='开发'?post.data.subtitle:'',category:post.data.category,href:`/posts/${post.id}/`})),
 ...moments.sort((a,b)=>a.id.localeCompare(b.id)).map(moment=>{
  const text=(moment.body??'').replace(/<[^>]*>/g,'').replace(/^\s{0,3}#{1,6}\s+/gm,'').replace(/\s+/g,' ').trim();
  const chars=[...text];
  return {date:moment.data.pubDate,title:chars.length?chars.slice(0,36).join('')+(chars.length>36?'…':''):'日常照片',subtitle:'',category:'日常',href:`/moments/#${encodeURIComponent(moment.id)}`};
 }),
].sort((a,b)=>b.date.valueOf()-a.date.valueOf());
const years=[...new Set(entries.map(entry=>entry.date.getUTCFullYear()))].sort((a,b)=>b-a).map(year=>({year,items:entries.filter(entry=>entry.date.getUTCFullYear()===year)}));
---
<BaseLayout title="归档" section="归档" description={`${SITE.name}的文章与日常，按时间倒序。`}>
 <div class="wrap archive-page"><header class="hd"><h1>归档</h1><p>{posts.length} 篇文章 · {moments.length} 条日常</p></header>
 <div class="timeline">{years.map(({year,items})=><section class="year"><h2>{year}<span>{items.length} 条</span></h2>{[...new Set(items.map(entry=>entry.date.getUTCMonth()))].map(month=><section class="month"><h3>{String(month+1).padStart(2,'0')} 月</h3><ol>{items.filter(entry=>entry.date.getUTCMonth()===month).map(entry=><li class:list={{right:items.indexOf(entry)%2===1}}><a class="timeline-entry" href={entry.href}><time datetime={entry.date.toISOString().slice(0,10)}>{fmtDate(entry.date).slice(5)}</time><div class="text"><h4>{entry.title}</h4>{entry.subtitle&&<p class="post-subtitle">{entry.subtitle}</p>}<span class={`chip ${categoryClass(entry.category)}`}>{entry.category}</span></div><span class="arrow" aria-hidden="true">↗</span></a></li>)}</ol></section>)}</section>)}</div>
 {entries.length===0&&<p class="empty">还没有记录。</p>}
 </div>
</BaseLayout>
<style>
.archive-page{padding-bottom:64px}.hd{display:flex;justify-content:space-between;align-items:baseline;gap:20px;padding:42px 0 30px;border-bottom:1px solid var(--rule)}h1{font:500 clamp(34px,4vw,54px) var(--disp)}.hd p{font:13px var(--ui);color:var(--ink-55)}
.timeline{position:relative;max-width:1080px;margin:48px auto 0}.timeline:before{content:'';position:absolute;inset:0 auto 0 50%;width:1px;background:var(--ink-38);transform:translateX(-50%)}
.year{position:relative;padding-bottom:40px}.year:last-child{padding-bottom:0}.year>h2{position:relative;display:flex;align-items:baseline;gap:14px;width:max-content;max-width:100%;margin:0 auto;padding:12px 18px;background:var(--bg);font:500 32px var(--disp)}.year>h2 span{font:12px var(--ui);color:var(--ink-55)}
.month{margin-top:26px}h3{position:relative;width:max-content;margin:0 auto 18px;padding:8px 14px;background:var(--bg);font:500 13px var(--mono);color:var(--ink-55)}ol{list-style:none;padding:0;margin:0}
li{position:relative;width:50%}li+li{margin-top:-20px}li.right{margin-left:50%}li:before{content:'';position:absolute;right:-4px;top:24px;width:8px;height:8px;background:var(--bg);border:1.5px solid var(--ink);border-radius:50%;z-index:1}li.right:before{right:auto;left:-4px}li:after{content:'';position:absolute;right:4px;top:28px;width:22px;height:1px;background:var(--rule-strong)}li.right:after{right:auto;left:4px}
.timeline-entry{display:block;position:relative;min-height:132px;padding:18px 40px 30px 0;text-align:right}.right .timeline-entry{padding:18px 0 30px 40px;text-align:left}.timeline-entry:hover h4{text-decoration:underline;text-underline-offset:5px}.timeline-entry:focus-visible{outline:2px solid var(--ink);outline-offset:5px}time{display:block;font:12px var(--mono);color:var(--ink-55);margin-bottom:10px}h4{font:500 22px/1.55 var(--disp);overflow-wrap:anywhere}.text .chip{display:inline-block;margin-top:12px}.post-subtitle{margin-top:6px}.arrow{display:none}.empty{padding:50px 0}
@media(max-width:700px){.timeline{margin-top:32px;padding-left:20px}.timeline:before{left:4px}.year>h2{font-size:28px;margin-left:0;padding-left:0}.month h3{margin-left:0;padding-left:0}li,li.right{width:100%;margin-left:0}li+li{margin-top:0}li:before,li.right:before{left:-20px;right:auto}li:after,li.right:after{left:-12px;right:auto;width:12px}.timeline-entry,.right .timeline-entry{padding:18px 0 26px 18px;text-align:left;min-height:0}h4{font-size:19px}.hd{padding-top:30px}}
</style>
