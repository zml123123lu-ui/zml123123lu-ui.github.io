---
import BaseLayout from '../layouts/BaseLayout.astro';
import fields from '../data/editor-fields.json';
import siteFields from '../data/site-fields.json';
---
<BaseLayout title="内容管理" section="管理" description="见己的内容管理。">
<div class="wrap manager"><header><span class="mono dim">见己 / 我的内容</span><h1>内容管理</h1><p>记录、整理，再公开。网站固定文案可在「网站文字」里修改，也可以回到页面点「编辑本页」。</p></header><p id="manager-status" role="status">正在确认编辑权限…</p>
<div id="manager-app" hidden><nav id="manager-tabs" aria-label="内容类型"></nav><div class="manager-grid"><aside><button class="btn" id="new-entry" type="button">新增</button><p id="entry-help">选择已有文章，可编辑或删除。</p><div id="entry-list"></div><a href="/music/">导入音乐歌单 →</a></aside><form id="entry-form"><div class="editor-top"><h2 id="editor-heading">新增</h2><button class="btn" id="remove-entry" type="button" hidden>删除文章</button></div><div id="editor-fields"></div><p><a id="preview-entry" hidden>查看本机预览 →</a></p><div class="actions"><button class="btn" type="submit">保存并更新页面</button></div><p class="editor-note">勾选草稿的文章只保存在管理页，访客看不到。保存只更新本机预览，确认效果后还需要单独上线。</p></form></div></div>
</div>
</BaseLayout>
<script is:inline define:vars={{ fields, siteFields }}>
(async()=>{
 const status=document.getElementById('manager-status'),app=document.getElementById('manager-app'),form=document.getElementById('entry-form'),list=document.getElementById('entry-list'),editor=document.getElementById('editor-fields');
 if(!['127.0.0.1','localhost'].includes(location.hostname)){status.textContent='编辑入口暂仅在站长本机开放。';return;}
 let token='',data={},kind='posts',id='',busy=false,media=[];
 const schema=()=>kind==='site'?siteFields[id]:fields[kind];
 const request=async(url,body)=>{const response=await fetch(url,{method:body?'POST':'GET',headers:{'X-Music-Token':token,...(body?{'Content-Type':'application/json'}:{})},...(body?{body:JSON.stringify(body)}:{})});let value;try{value=await response.json()}catch{throw new Error('本机管理服务未启动，请使用 npm run serve 启动。')}if(!response.ok)throw new Error(value.error||'保存失败');return value;};
 const lock=value=>{busy=value;app.setAttribute('aria-busy',String(value));app.querySelectorAll('button,input,textarea,select').forEach(node=>{if(value){node.dataset.lockDisabled=String(node.disabled);node.disabled=true}else if(node.dataset.lockDisabled!==undefined){node.disabled=node.dataset.lockDisabled==='true';delete node.dataset.lockDisabled}})};
 const imageField=(key,label,type)=>{
  const group=document.createElement('div');group.className='media-field';const heading=document.createElement('p');heading.textContent=label;const chooser=document.createElement('input');chooser.type='file';chooser.accept='image/jpeg,image/png,image/webp';chooser.multiple=type==='images';chooser.setAttribute('aria-label',label);const images=document.createElement('div');images.className='media-list';
  const draw=()=>{images.replaceChildren();media.forEach((image,index)=>{const row=document.createElement('div');row.className='media-row';const preview=document.createElement('img');preview.src=image.src;preview.alt=image.alt||'已选照片';row.append(preview);
   if(type==='images'){const description=document.createElement('input');description.type='text';description.maxLength=300;description.value=image.alt;description.placeholder='图片描述（选填）';description.setAttribute('aria-label',`照片 ${index+1} 的描述`);description.oninput=()=>image.alt=description.value;row.append(description)}
   const button=(text,action,disabled=false)=>{const b=document.createElement('button');b.type='button';b.className='btn';b.textContent=text;b.disabled=disabled;b.onclick=action;row.append(b)};
   if(type==='images'){button('上移',()=>{[media[index-1],media[index]]=[media[index],media[index-1]];draw()},index===0);button('下移',()=>{[media[index+1],media[index]]=[media[index],media[index+1]];draw()},index===media.length-1)}
   button('移除',()=>{media.splice(index,1);draw()});images.append(row)
  })};
  chooser.onchange=async()=>{const files=[...chooser.files];if(!files.length)return;if(type==='images'&&media.length+files.length>9){status.textContent='每条日常最多放 9 张照片。';chooser.value='';return}lock(true);status.textContent='正在处理照片…';
   try{for(const file of files){if(file.size>10*1024*1024)throw Error('每张照片请控制在 10MB 以内。');const data=await new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(String(reader.result).split(',')[1]);reader.onerror=()=>reject(Error('无法读取照片。'));reader.readAsDataURL(file)});const image=await request('/api/content/upload',{data});if(type==='image')media=[{src:image.src,alt:''}];else media.push({src:image.src,alt:''})}status.textContent='照片已处理，请保存这条内容。'}catch(error){status.textContent=error.message}finally{lock(false);chooser.value='';draw()}
  };
  group.append(heading,chooser,images);editor.append(group);draw();
 };
 const edit=(entry={})=>{id=entry.id||'';media=kind==='albums'?(entry.cover?[{src:entry.cover,alt:''}]:[]):(entry.images||[]).map(image=>({...image}));editor.replaceChildren();const preview=document.getElementById('preview-entry');preview.hidden=!id||!['albums','moments','books','films'].includes(kind);if(!preview.hidden)preview.href=kind==='albums'?`/music/albums/${id}/`:kind==='moments'?`/moments/#${id}`:`/${kind==='books'?'shelf':'films'}/${id}/`;document.getElementById('editor-heading').textContent=(id?'编辑':'新增')+schema().label;document.getElementById('remove-entry').hidden=!id||kind==='site';document.getElementById('remove-entry').textContent=kind==='posts'?'删除文章':'删除记录';document.querySelectorAll('#entry-list button').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.id===id)));document.getElementById('new-entry').hidden=kind==='site';
 for(const [key,label,type,options] of schema().fields){if(type==='image'||type==='images'){imageField(key,label,type);continue}const group=document.createElement('label'),name=document.createElement('span');name.textContent=label;let input=document.createElement(type==='textarea'?'textarea':type==='select'?'select':'input');input.name=key;if(type==='select'){for(const option of options){const node=document.createElement('option');node.value=option;node.textContent=option;input.append(node)}}else if(type!=='textarea')input.type=key==='cover'&&['books','films'].includes(kind)?'text':type;
 if(type==='checkbox')input.checked=entry[key]??true;else input.value=entry[key]??(type==='date'?new Date().toLocaleDateString('sv-SE'):type==='select'?options[0]:'');if(key==='title')input.required=true;if(type==='number'){input.min='1';input.max='5';input.step='1'}if(key==='body'||(key==='note'&&['books','films'].includes(kind)))input.rows=18;else if(type==='textarea')input.rows=4;group.append(name,input);editor.append(group)}
 };
 const show=()=>{list.replaceChildren();for(const entry of data[kind]||[]){const button=document.createElement('button');button.type='button';button.dataset.id=entry.id;button.textContent=(entry.draft?'[草稿] ':'')+(kind==='site'?siteFields[entry.id].label:(entry.title||entry.pubDate));button.onclick=()=>edit(entry);list.append(button)}if(!(data[kind]||[]).length){const empty=document.createElement('p');empty.textContent='还没有记录，点新增开始。';list.append(empty)}document.querySelectorAll('#manager-tabs button').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.kind===kind)));document.getElementById('entry-help').textContent=kind==='site'?'选择要修改的网站文字。':kind==='posts'?'选择已有文章，可编辑或删除。':'选择已有记录，可编辑或删除。';edit(data[kind]?.[0]||{});};
 for(const key of ['posts','albums','moments','books','films','works','accounts','site']){const button=document.createElement('button');button.type='button';button.textContent=key==='site'?'网站文字':fields[key].label;button.dataset.kind=key;button.onclick=()=>{if(!busy){kind=key;show()}};document.getElementById('manager-tabs').append(button)}
 const save=async(operation)=>{if(busy)return;const entry={id};if(operation==='save')for(const [key,,type] of schema().fields){const input=form.elements.namedItem(key);entry[key]=type==='images'?media:type==='image'?(media[0]?.src||''):type==='checkbox'?input.checked:input.value}if(!id)delete entry.id;lock(true);status.textContent=operation==='remove'?'正在删除并更新页面，请稍等…':'正在保存并更新页面，请稍等…';try{const result=await request('/api/content/save',{kind,entry,operation});data=await request('/api/content');show();if(operation!=='remove')edit(data[kind].find(item=>item.id===result.id));status.textContent=operation==='remove'?(kind==='posts'?'已从本机删除文章，尚未上线。':'已从本机删除记录，尚未上线。'):'已保存到本机预览，尚未上线。'}catch(error){status.textContent=error.message}finally{lock(false)}};
 form.onsubmit=event=>{event.preventDefault();save('save')};document.getElementById('remove-entry').onclick=()=>{if(busy||!id)return;const selected=data[kind].find(item=>item.id===id);if(!selected)return;const message=kind==='posts'?`确定删除《${selected.title}》？\n文章正文也会删除，无法在网站中恢复。只想暂时隐藏，可以取消并改为草稿。`:`确定删除「${selected.title||selected.pubDate}」这条记录？`;if(confirm(message))save('remove')};document.getElementById('new-entry').onclick=()=>{if(!busy)edit()};
 try{token=(await request('/api/music/status')).token;data=await request('/api/content');show();app.hidden=false;const postId=new URLSearchParams(location.search).get('post'),selected=data.posts.find(item=>item.id===postId);if(selected){edit(selected);form.scrollIntoView({block:'start'})}status.textContent='本机编辑已开启。保存更新本机预览，发布到公开网站需另行确认。'}catch(error){status.textContent=error.message}
})();
</script>
<style>
.manager{padding-bottom:50px}header{padding:40px 0 25px;border-bottom:1px solid var(--rule)}h1{font:700 clamp(34px,4vw,50px) var(--disp);margin:14px 0}header p,#manager-status,.editor-note{font:13px/1.9 var(--ui);color:var(--ink-55)}#manager-status{margin:20px 0}#manager-tabs{display:flex;gap:0;border-bottom:1px solid var(--rule);flex-wrap:wrap}#manager-tabs :global(button){padding:15px 24px;background:var(--bg);color:var(--ink);border:0;border-bottom:2px solid transparent;cursor:pointer;font:14px var(--ui)}#manager-tabs :global(button[aria-pressed=true]){border-bottom-color:var(--yellow)}.manager-grid{display:grid;grid-template-columns:250px minmax(0,1fr);gap:36px;padding-top:28px}aside{border-right:1px solid var(--rule);padding-right:24px}#entry-list{margin:20px 0;max-height:560px;overflow:auto}#entry-list :global(button){display:block;width:100%;text-align:left;padding:12px 0;border:0;border-bottom:1px solid var(--rule);background:var(--bg);color:var(--ink);font:13px/1.7 var(--ui);cursor:pointer}aside a{font:12px var(--ui)}.editor-top{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;margin-bottom:25px}h2{font:500 25px var(--disp);margin:0}.editor-top .btn{flex-shrink:0}#entry-help{font:12px/1.8 var(--ui);color:var(--ink-55);margin-top:16px}#entry-list :global(button[aria-pressed=true]){background:var(--yellow);color:var(--on-light);padding-inline:8px}#editor-fields :global(label){display:block;margin:0 0 22px;font:13px var(--ui)}#editor-fields :global(label>span){display:block;margin-bottom:10px}#editor-fields :global(input:not([type=checkbox])),#editor-fields :global(textarea),#editor-fields :global(select){width:100%;border:1px solid var(--rule-strong);padding:12px;background:var(--bg);color:var(--ink);border-radius:0;font:14px/1.7 var(--ui)}#editor-fields :global(textarea){resize:vertical}#remove-entry[hidden],#new-entry[hidden]{display:none}.actions{display:flex;gap:16px;flex-wrap:wrap}.editor-note{margin-top:15px}:global(button:disabled){cursor:wait;opacity:.5}@media(max-width:760px){.manager-grid{grid-template-columns:1fr}aside{border-right:0;border-bottom:1px solid var(--rule);padding:0 0 20px}#entry-list{max-height:180px}#manager-tabs :global(button){padding:12px 17px}}
:global(.media-field){margin-bottom:24px;font:13px/1.8 var(--ui)}:global(.media-field input[type=file]){margin:12px 0;max-width:100%}:global(.media-row){display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:12px 0;border-bottom:1px solid var(--rule)}:global(.media-row img){width:90px;height:90px;object-fit:contain}:global(.media-row input){min-width:150px;flex:1;padding:8px;border:1px solid var(--rule-strong);background:var(--bg);color:var(--ink)}#preview-entry{font:13px var(--ui);text-decoration:underline}#preview-entry[hidden]{display:none}</style>
