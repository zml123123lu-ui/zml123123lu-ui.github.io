---
import BaseLayout from '../../layouts/BaseLayout.astro';
const projects = [
 {name:'远行 · 生活工作台',label:'生活管理',description:'整合今日安排、计划、健康、财务与记录。根据实际使用反馈持续修改，例如让记账周期跟随发薪日，并联动账单与资金分配。',url:'https://workbench-full.pages.dev/'},
 {name:'生活记录',label:'日常记录',description:'围绕生活记录、日常安排与周期维护进行的个人应用实践。',url:'https://zml123123lu-ui.github.io/daybook-web/#maintenance'},
 {name:'日序',label:'日常安排',description:'围绕日常安排与记录进行的个人应用实践。',url:'https://life-log-diary.app.workbuddy.host/'},
];
---
<BaseLayout title="Vibe Coding 成果" section="作品" description="我的 AI 协作开发实践：远行·生活工作台、生活记录与日序。">
 <div class="wrap coding-page">
  <header class="heading"><a class="mono" href="/works/">← 全部作品</a><h1>Vibe Coding 成果</h1><p>从自己的生活需要出发，尝试把想法做成能用的东西。</p><p class="role">需求、流程与界面方案由我提出，AI 协作实现代码。</p></header>
  <div class="projects">{projects.map((project,i)=><article>
   <div class="meta"><span>{String(i+1).padStart(2,'0')}</span><span>{project.label}</span></div>
   <h2>{project.name}</h2><p>{project.description}</p><a class="btn" href={project.url} target="_blank" rel="noopener noreferrer">打开原项目 ↗</a>
  </article>)}</div>
  <p class="note">生活记录与日序目前未持续使用。原项目可能需要登录。</p>
 </div>
</BaseLayout>
<style>
.heading{padding:42px 0 30px;border-bottom:1px solid var(--rule)}.heading>a{font-size:12px;color:var(--ink-55)}h1{font:700 clamp(32px,4vw,54px)/1.3 var(--disp);margin:24px 0 16px}.heading p{font:16px/1.85 var(--song);color:var(--ink-72)}.heading .role{font-size:13px;margin-top:12px;color:var(--ink-55)}.projects{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-left:1px solid var(--rule);margin-top:30px}.projects article{padding:30px;border-right:1px solid var(--rule);border-bottom:1px solid var(--rule);border-top:1px solid var(--rule);min-width:0}.meta{display:flex;justify-content:space-between;font:11px var(--mono);color:var(--ink-55)}h2{font:600 25px/1.4 var(--disp);margin:25px 0 16px}.projects p{font:15px/1.9 var(--song);color:var(--ink-72);margin-bottom:24px}.note{font:12px/1.8 var(--ui);color:var(--ink-55);margin:24px 0 40px}@media(max-width:760px){.projects{grid-template-columns:1fr}.projects article{padding:24px}.heading{padding-top:30px}}
</style>
