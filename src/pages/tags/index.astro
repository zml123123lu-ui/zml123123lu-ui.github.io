---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, categoryCounts, tagCounts } from '../../utils/posts';
const posts=await getPosts();
const categories=categoryCounts(posts).filter(category=>category.count>0);
const categoryNames=new Set(categories.map(category=>category.name));
const topics=[...categories,...tagCounts(posts).filter(tag=>!categoryNames.has(tag.name))];
const largest=Math.max(1,...topics.map(topic=>topic.count));
---
<BaseLayout title="标签" section="标签" description="按主题浏览全部文章。">
 <div class="wrap tags-page">
  <header class="hd"><h1>标签</h1><button class="motion-toggle" type="button" aria-pressed="false" hidden>暂停漂浮</button></header>
  <ul class="bubble-field" aria-label="按主题浏览文章" hidden={topics.length===0}>
   {topics.map((topic,index)=>{
    const weight=Math.sqrt(topic.count/largest);
    const size=Math.round(Math.max(88,[...topic.name].length*14+22,74+weight*142+(index*67+51)%151-60));
    const depth=size>=178?80:size<=120?-100:0;
    return <li class="bubble-slot" data-depth={depth} style={`--plane:${depth}px;--size:${size}px;--type:${15+(size-88)*.075}px;--drift-x:${12+index%3*2}px;--drift-y:${22+index%4*3}px;--duration:${7.2+(index*7)%11*.29}s;--sway-duration:${11.3+(index*11)%17*.41}s;--delay:${-1.2-index*1.73}s`}>
     <a class="tag-bubble" href={`/tags/${encodeURIComponent(topic.name)}/`} aria-label={`${topic.name}，${topic.count} 篇文章`}><span class="reflection reflection-left" aria-hidden="true"></span><span class="reflection reflection-right" aria-hidden="true"></span><span class="name">{topic.name}</span><span class="count">{topic.count} 篇</span></a>
    </li>;
   })}
  </ul>
  {topics.length===0&&<p class="empty">还没有文章标签。</p>}
 </div>
</BaseLayout>
<script>
const field=document.querySelector<HTMLUListElement>('.bubble-field');
const toggle=document.querySelector<HTMLButtonElement>('.motion-toggle');
if(field&&toggle&&field.children.length){
 const slots=[...field.querySelectorAll<HTMLLIElement>('.bubble-slot')];
 const depths=slots.map(slot=>Number(slot.dataset.depth));
 let pointerFrame=0;
 let lastWidth=0,paused=false,visible=true;
 const sync=()=>{field.dataset.running=String(!paused&&visible&&!document.hidden)};
 const arrange=()=>{
  const width=field.clientWidth;
  if(!width||Math.abs(width-lastWidth)<1)return;
  lastWidth=width;
  const sizes=slots.map(slot=>slot.getBoundingClientRect().width);
  const compact=matchMedia('(max-width:700px)').matches;
  const circles=sizes.map((size,index)=>({index,r:size/2*900/(900-depths[index]*(compact?.6:1))+(compact?10:16)})).sort((a,b)=>b.r-a.r);
  let height=Math.max(420,Math.min(700,innerHeight-300),Math.ceil(circles.reduce((area,c)=>area+Math.PI*c.r*c.r,0)/(width*.62)));
  let positions:{index:number,r:number,x:number,y:number}[]=[];
  // 固定种子保持排布稳定；按圆形间距散布，不再按行列摆放。
  for(let attempt=0;attempt<12;attempt++){
   let seed=214;
   const random=()=>{seed=(Math.imul(seed,1664525)+1013904223)>>>0;return seed/4294967296};
   positions=[];
   for(const circle of circles){
    for(let trial=0;trial<900;trial++){
     const x=circle.r+12+random()*(width-circle.r*2-24);
     const y=circle.r+20+random()*(height-circle.r*2-40);
     if(positions.every(other=>Math.hypot(x-other.x,y-other.y)>=circle.r+other.r+4)){
      positions.push({...circle,x,y});break;
     }
    }
    if(positions.length<circles.indexOf(circle)+1)break;
   }
   if(positions.length===circles.length)break;
   height=Math.ceil(height*1.08);
  }
  // 极窄窗口或将来标签增多时，仍保留所有入口。
  if(positions.length<circles.length){
   let y=20;
   positions=circles.map(circle=>{y+=circle.r;const point={...circle,x:width/2,y};y+=circle.r+20;return point});
   height=y;
  }
  for(const point of positions){
   slots[point.index].style.left=`${point.x-sizes[point.index]/2}px`;
   slots[point.index].style.top=`${point.y-sizes[point.index]/2}px`;
  }
  field.style.height=`${height}px`;
  field.classList.add('is-arranged');
 };
 arrange();
 new ResizeObserver(arrange).observe(field);
 const look=(x:number,y:number)=>{
  cancelAnimationFrame(pointerFrame);
  pointerFrame=requestAnimationFrame(()=>slots.forEach((slot,index)=>{
   if(slot.matches(':hover,:focus-within'))return;
   const distance=depths[index]>0?12:depths[index]<0?-3:5;
   slot.style.transform=`translate3d(${x*distance}px,${y*distance*.6}px,0)`;
  }));
 };
 field.addEventListener('pointermove',event=>{
  if(event.pointerType!=='mouse'||paused||!visible||document.hidden)return;
  look((event.clientX/innerWidth-.5)*2,(event.clientY/innerHeight-.5)*2);
 });
 field.addEventListener('pointerleave',()=>look(0,0));

 new IntersectionObserver(([entry])=>{visible=entry.isIntersecting;sync()}).observe(field);
 document.addEventListener('visibilitychange',sync);
 window.addEventListener('pagehide',()=>{cancelAnimationFrame(pointerFrame);field.dataset.running='false'});
 window.addEventListener('pageshow',sync);
 toggle.hidden=false;
 toggle.addEventListener('click',()=>{paused=!paused;toggle.textContent=paused?'播放漂浮':'暂停漂浮';toggle.setAttribute('aria-pressed',String(paused));sync()});
 sync();
}
</script>
<style>
.tags-page{padding-bottom:48px}.hd{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:42px 0 30px;border-bottom:1px solid var(--rule)}h1{font:500 clamp(34px,4vw,54px) var(--disp)}
.motion-toggle{border:0;border-bottom:1px solid var(--rule-strong);background:none;padding:8px 0;color:var(--ink);font:12px var(--ui);cursor:pointer}.motion-toggle[hidden]{display:none}
.bubble-field{position:relative;display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:32px;list-style:none;margin:26px 0 0;padding:24px;min-height:400px}.bubble-field[hidden]{display:none}.bubble-slot{--depth:var(--plane);--shadow-y:3px;--shadow-blur:18px;--shadow-alpha:.045;width:var(--size);height:var(--size);flex:none;list-style:none;perspective:900px;z-index:2;transition:transform .55s cubic-bezier(.22,.7,.25,1)}.bubble-slot[data-depth="80"]{--shadow-y:5px;--shadow-blur:24px;--shadow-alpha:.065;z-index:3}.bubble-slot[data-depth="-100"]{--shadow-y:2px;--shadow-blur:14px;--shadow-alpha:.025;z-index:1}.bubble-slot:hover,.bubble-slot:focus-within{z-index:4}.bubble-field.is-arranged{display:block;padding:0}.is-arranged .bubble-slot{position:absolute}
.tag-bubble{--float-scale:1;position:relative;isolation:isolate;display:flex;width:100%;height:100%;flex-direction:column;align-items:center;justify-content:center;gap:9px;padding:10px;border:1px solid rgb(158 174 179/.22);border-radius:50%;background:radial-gradient(ellipse at 51% 49%,rgb(166 174 180/.065),transparent 85%);box-shadow:inset 0 0 3px rgb(167 183 190/.12),0 var(--shadow-y) var(--shadow-blur) -5px rgb(24 42 52/var(--shadow-alpha));color:var(--ink);text-decoration:none;transition:border-color .2s}
.tag-bubble:before{content:'';position:absolute;inset:-1px;border-radius:50%;background:conic-gradient(from -25deg,#9cded5 0deg,#b2cbed 26deg,#efcadf 57deg,#f9edca 88deg,#d5d8ed 113deg,#a5e2e7 148deg,#efd0de 175deg,#dfd4ed 211deg,#b3e9d5 250deg,#cadfe9 280deg,#f2cddd 317deg,#aed6e4 343deg,#9cded5 360deg);-webkit-mask:radial-gradient(closest-side,transparent 48%,rgb(0 0 0/.015) 64%,rgb(0 0 0/.07) 77%,rgb(0 0 0/.22) 87%,rgb(0 0 0/.6) 95%,transparent 100%);mask:radial-gradient(closest-side,transparent 48%,rgb(0 0 0/.015) 64%,rgb(0 0 0/.07) 77%,rgb(0 0 0/.22) 87%,rgb(0 0 0/.6) 95%,transparent 100%);opacity:.68;filter:saturate(.85) blur(.85px);pointer-events:none}
.tag-bubble:after{content:'';position:absolute;inset:0;border-radius:50%;background:radial-gradient(ellipse at 76% 82%,rgb(255 255 255/.55),rgb(255 255 255/.14) 22%,transparent 54%);pointer-events:none}
.reflection{position:absolute;display:block;pointer-events:none;border-radius:65% 35% 60% 40% / 55% 45% 55% 45%;background:radial-gradient(ellipse at 42% 42%,#fff 32%,rgb(255 255 255/.95) 50%,rgb(255 255 255/.35) 80%,transparent 100%);filter:blur(.6px);box-shadow:0 1px 6px rgb(139 166 178/.065)}.reflection-left{width:26%;height:11%;left:calc(13% + var(--glint-shift,0%));top:calc(17% - var(--glint-shift,0%)*.5);transform:rotate(calc(-47deg + var(--glint-turn,0deg))) scale(var(--glint-scale,1))}.reflection-right{width:12%;height:6%;right:15%;top:21%;transform:rotate(calc(40deg + var(--glint-turn,0deg))) scale(var(--glint-scale,1));opacity:.6}
.bubble-slot:nth-child(3n+2){--glint-turn:7deg;--glint-shift:2%;--glint-scale:.86}.bubble-slot:nth-child(3n){--glint-turn:-5deg;--glint-shift:-1%;--glint-scale:1.08}
.bubble-slot[data-depth="-100"] .tag-bubble:before{opacity:.46;filter:saturate(.85) blur(.85px)}
.name{position:relative;z-index:1;font:500 var(--type)/1.35 var(--disp);text-align:center;overflow-wrap:anywhere}.count{position:relative;z-index:1;font:11px var(--mono);color:var(--ink-55)}.tag-bubble:hover{border-color:rgb(133 183 203/.6)}.tag-bubble:hover .name{text-decoration:underline;text-underline-offset:5px}.tag-bubble:focus-visible,.motion-toggle:focus-visible{outline:2px solid var(--ink);outline-offset:5px}
.is-arranged .tag-bubble{animation:bubble-bob var(--duration) cubic-bezier(.37,0,.63,1) var(--delay) infinite,bubble-sway var(--sway-duration) cubic-bezier(.37,0,.63,1) calc(var(--delay)*1.91) infinite}.bubble-field[data-running=false] .tag-bubble,.bubble-slot:hover .tag-bubble,.bubble-slot:focus-within .tag-bubble{animation-play-state:paused}
/* 两轴周期和起点错开，形成连续弯曲的路线；文字保持水平。 */
@keyframes bubble-bob{0%,100%{transform:translate3d(0,calc(var(--drift-y)*var(--float-scale)*.65),var(--depth))}50%{transform:translate3d(0,calc(var(--drift-y)*var(--float-scale)*-1),var(--depth))}}
@keyframes bubble-sway{0%,100%{translate:calc(var(--drift-x)*var(--float-scale)*-1) 0}50%{translate:calc(var(--drift-x)*var(--float-scale)) 0}}
.empty{padding:40px 0;color:var(--ink-55);font:15px var(--ui)}
@media(prefers-color-scheme:dark){.tag-bubble{border-color:rgb(191 210 217/.22);background:radial-gradient(ellipse at 51% 49%,rgb(203 215 223/.025),transparent 85%);box-shadow:inset 0 0 3px rgb(206 225 235/.12),0 var(--shadow-y) var(--shadow-blur) -5px rgb(0 0 0/.3)}.tag-bubble:before{opacity:.42}.tag-bubble:after{background:radial-gradient(ellipse at 76% 82%,rgb(255 255 255/.035),transparent 54%)}.reflection{opacity:.6}.reflection-right{opacity:.3}}
@media(max-width:700px){.hd{padding-top:30px}.bubble-field{margin-top:22px;gap:18px;padding:16px}.bubble-slot{--depth:calc(var(--plane)*.6);width:clamp(76px,calc(var(--size)*.64),150px);height:clamp(76px,calc(var(--size)*.64),150px)}.tag-bubble{--float-scale:.65;gap:5px;padding:8px}.name{font-size:clamp(14px,calc(var(--type)*.74),17px)}.count{font-size:11px}}
/* 用户明确要求默认漂浮，仅覆盖本页的全局减少动效规则；仍可随时暂停。 */
@media(prefers-reduced-motion:reduce){.is-arranged .tag-bubble{animation-duration:var(--duration),var(--sway-duration)!important;animation-iteration-count:infinite!important}}
</style>
