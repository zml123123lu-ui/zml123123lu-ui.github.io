---
import {getCollection,render} from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
export async function getStaticPaths(){return (await getCollection('albums')).map(album=>({params:{id:album.id},props:{album}}))}
const {album}=Astro.props;const {Content}=await render(album);const d=album.data;
---
<BaseLayout title={`${d.title} · ${d.artist}`} section="书影音" description={`${d.artist}《${d.title}》——我的专辑感受。`} ogImage={d.cover}>
 <div class="wrap album-page">
  <a class="back" href="/music/#albums">← 专辑单</a>
  <header class="album-heading"><img src={d.cover} alt={`${d.title}专辑封面`} width="360" height="360" /><div><h1 data-pagefind-meta="title">{d.title}</h1><p class="artist">{d.artist}</p>{d.releaseYear && <p class="year">{d.releaseYear}</p>}{d.url && <a class="listen" href={d.url} target="_blank" rel="noopener noreferrer">去听这张专辑 ↗</a>}</div></header>
  <article class="prose" data-pagefind-body><span class="sr-only">{d.title} {d.artist}</span><Content /></article>
  <a class="back return" href="/music/#albums">← 返回专辑单</a>
 </div>
</BaseLayout>
<style>
.album-page{padding-block:30px 60px}.back{font:13px var(--ui);text-underline-offset:5px}.back:hover{text-decoration:underline}.album-heading{display:grid;grid-template-columns:minmax(0,300px) minmax(0,1fr);align-items:center;gap:60px;padding:48px 0;border-bottom:1px solid var(--rule);margin-bottom:48px}.album-heading img{width:100%;height:auto;aspect-ratio:1;object-fit:contain}h1{font:500 clamp(30px,4vw,48px)/1.3 var(--disp);overflow-wrap:anywhere}.artist{font:20px/1.8 var(--song);margin-top:16px}.year,.listen{font:13px/1.8 var(--ui);color:var(--ink-55)}.listen{display:inline-block;margin-top:24px;text-decoration:underline}.prose{max-width:var(--measure);margin-inline:auto}.return{display:block;margin-top:60px}@media(max-width:650px){.album-heading{grid-template-columns:1fr;gap:24px;padding:32px 0}.album-heading img{max-width:300px;margin-inline:auto}.album-heading>div{text-align:center}.album-heading h1{font-size:32px}.album-page{padding-bottom:40px}}
</style>
