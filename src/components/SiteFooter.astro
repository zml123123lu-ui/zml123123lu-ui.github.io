---
import { NAV, SITE } from '../consts';
const year = new Date().getFullYear();
---
<footer class="foot"><div class="wrap fin">
 <span class="brand">{SITE.name} <span>© {year}</span></span>
 <nav class="links" aria-label="页脚导航">
  {NAV.map(item=><a href={item.href}>{item.label}</a>)}
  <a href="/search/">搜索</a><a href="/rss.xml">RSS</a>
 </nav>
</div></footer>
<style>
.foot{border-top:1px solid var(--rule);margin-top:8px}
.fin{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;padding-block:24px}
.brand{font:500 14px var(--disp);white-space:nowrap}.brand span{font:10px var(--mono);color:var(--ink-55);margin-left:8px}
.links{display:flex;gap:16px;flex-wrap:wrap;font:11px/1.8 var(--ui);color:var(--ink-55)}
.links a:hover{color:var(--ink);text-decoration:underline;text-underline-offset:5px}
</style>
