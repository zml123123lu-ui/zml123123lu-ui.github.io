---
interface Book { id: string; title: string; subtitle?: string; cover?: string; url?: string; }
interface Props { items: Book[]; }
const { items } = Astro.props;
---
{items.length > 0 && <section class="book-orbit" aria-label="环绕书架">
  <div class="orbit-stage">
    <div class="orbit-caption" aria-live="polite" aria-atomic="true">
      <p class="orbit-title" data-edit-kind="books" data-edit-id={items[0].id} data-edit-field="title">{items[0].title}</p>
      <p class="orbit-author" data-edit-kind="books" data-edit-id={items[0].id} data-edit-field="subtitle">{items[0].subtitle}</p>
    </div>
    {items.map((book, index) => {
      const Tag = book.url ? 'a' : 'div';
      return <div class="orbit-slot" style={`--angle:${index * 360 / items.length}deg`}>
        <Tag class="orbit-book" href={book.url} target={book.url ? '_blank' : undefined} rel={book.url ? 'noopener noreferrer' : undefined} aria-label={`${book.title}，${book.subtitle || ''}`} data-id={book.id} data-title={book.title} data-author={book.subtitle || ''}>
          {book.cover ? <img src={book.cover} alt={`${book.title}封面`} width="112" height="160" loading="lazy" /> : <span class="orbit-placeholder">{book.title}</span>}
        </Tag>
      </div>;
    })}
  </div>
  <div class="orbit-controls"><button type="button" class="orbit-motion" aria-pressed="false" hidden>播放环绕 ↗</button></div>
</section>}
<style>
.book-orbit{max-width:1000px;margin:0 auto 40px;overflow:clip;overflow-clip-margin:12px}
.orbit-stage{--radius:clamp(180px,25vw,250px);position:relative;box-sizing:content-box;height:190px;padding-block:var(--radius)}
.orbit-slot{position:absolute;left:50%;top:50%;width:0;height:0;transform:rotate(var(--angle)) translateY(calc(-1 * var(--radius)));pointer-events:none}
.orbit-book{display:flex;align-items:center;justify-content:center;width:112px;height:160px;transform:translate(-50%,-50%) rotate(calc(-1 * var(--angle)));pointer-events:auto;outline-offset:8px}
.orbit-book img{display:block;width:auto;height:auto;max-width:100%;max-height:100%;object-fit:contain}
.orbit-placeholder{display:flex;align-items:center;justify-content:center;width:100%;height:100%;padding:12px;border:1px solid var(--rule);font:18px/1.5 var(--song);text-align:center}
.orbit-caption{position:absolute;left:50%;top:50%;width:260px;transform:translate(-50%,-50%);text-align:center;pointer-events:none}
:global(body.editing-page) .orbit-caption{pointer-events:auto}

.orbit-title{font:500 28px/1.5 var(--song);margin-top:18px;text-wrap:balance}
.orbit-author{font:12px/1.8 var(--ui);margin-top:10px;color:var(--ink-72);text-wrap:balance}
.orbit-controls{display:flex;align-items:center;justify-content:flex-end;gap:20px;font:11px/1.6 var(--ui);color:var(--ink-55);padding:16px 0 24px;border-bottom:1px solid var(--rule)}
.orbit-motion{font:inherit;color:var(--ink);padding:6px 0;border-bottom:1px solid var(--rule-strong)}
.orbit-motion[hidden]{display:none}
@media(max-width:600px){
 .book-orbit{margin-bottom:24px}
 .orbit-stage{--radius:calc((100vw - 108px) / 2);height:132px}
 .orbit-book{width:62px;height:92px;outline-offset:4px}
 .orbit-caption{width:136px}

 .orbit-title{font-size:clamp(14px,4vw,17px);line-height:1.5;margin-top:12px}
 .orbit-author{font-size:10px;line-height:1.7;margin-top:6px}
 .orbit-controls{gap:12px;font-size:10px;padding:12px 0 20px}
}
</style>
<script>
const root = document.querySelector<HTMLElement>('.book-orbit');
if (root) {
  const stage = root.querySelector<HTMLElement>('.orbit-stage')!;
  const slots = [...root.querySelectorAll<HTMLElement>('.orbit-slot')];
  const button = root.querySelector<HTMLButtonElement>('.orbit-motion')!;
  const title = root.querySelector<HTMLElement>('.orbit-title')!;
  const author = root.querySelector<HTMLElement>('.orbit-author')!;
  const duration = 42000;
  let wanted = true;
  let visible = false, hovered = false, focused = false;
  let animations: Animation[] = [];
  const sync = () => {
    const playing = wanted && visible && !hovered && !focused && !document.hidden;
    animations.forEach(a => playing ? a.play() : a.pause());
    root.dataset.orbitState = playing ? 'running' : 'paused';
    button.textContent = wanted ? '暂停环绕 ‖' : '播放环绕 ↗';
    button.setAttribute('aria-pressed', String(wanted));
  };
  const arrange = () => {
    const time = Number(animations[0]?.currentTime || 0);
    animations.forEach(a => a.cancel());
    animations = [];
    const radius = parseFloat(getComputedStyle(stage).paddingTop);
    slots.forEach((slot, i) => {
      const angle = i * 360 / slots.length;
      const orbit = slot.animate([
        { transform: `rotate(${angle}deg) translateY(-${radius}px)` },
        { transform: `rotate(${angle + 360}deg) translateY(-${radius}px)` },
      ], { duration, iterations: Infinity });
      const cover = slot.firstElementChild!.animate([
        { transform: `translate(-50%,-50%) rotate(${-angle}deg)` },
        { transform: `translate(-50%,-50%) rotate(${-angle - 360}deg)` },
      ], { duration, iterations: Infinity });
      for (const a of [orbit, cover]) { a.pause(); a.currentTime = time; animations.push(a); }
    });
    sync();
  };
  const show = (book: HTMLElement) => {
    title.textContent = book.dataset.title!;
    author.textContent = book.dataset.author!;
    title.dataset.editId = author.dataset.editId = book.dataset.id!;
  };
  root.querySelectorAll<HTMLElement>('.orbit-book').forEach(book => {
    book.addEventListener('pointerenter', e => { if (e.pointerType === 'touch') return; hovered = true; show(book); sync(); });
    book.addEventListener('pointerleave', () => { hovered = false; sync(); });
    book.addEventListener('focus', () => { focused = true; show(book); sync(); });
    book.addEventListener('blur', () => { focused = false; sync(); });
  });
  button.hidden = false;
  button.addEventListener('click', () => { wanted = !wanted; sync(); });
  document.getElementById('edit-toggle')?.addEventListener('click', () => { wanted = false; sync(); });
  document.addEventListener('visibilitychange', sync);
  const resize = new ResizeObserver(arrange);
  resize.observe(stage);
  const intersection = new IntersectionObserver(entries => { visible = entries[0].isIntersecting; sync(); });
  intersection.observe(stage);
  window.addEventListener('pagehide', () => { animations.forEach(a => a.cancel()); resize.disconnect(); intersection.disconnect(); });
  window.addEventListener('pageshow', e => { if (e.persisted) { resize.observe(stage); intersection.observe(stage); } });
}
</script>
